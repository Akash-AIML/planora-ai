# ==========================================
# PLANORA AI — ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini / AI Studio API Key
# Get a free key at: https://aistudio.google.com/app/apikey
# Both GEMINI_API_KEY and GOOGLE_API_KEY are supported by the server API route (/api/plan and /api/extract).
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
# Defaults to Google Gemma 2 (gemma-2-27b-it) for superior free-tier limits and unthrottled generation.
# Supported options: gemma-2-27b-it (default), gemma-2-9b-it, gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemma-2-27b-it
