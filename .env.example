# ==========================================
# PLANORA AI — VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini / AI Studio API Key (REQUIRED for live AI Extraction & Ideas)
# Get a key at: https://aistudio.google.com/app/apikey
# Both GEMINI_API_KEY and GOOGLE_API_KEY are supported.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. LLM Model Selection (OPTIONAL)
# Defaults to gemma-4-26b-a4b-it with automated fallbacks to gemini-flash-latest and gemini-3.5-flash-lite.
# Recommended options:
# - gemma-4-26b-a4b-it (Default, high reasoning capacity)
# - gemini-3.5-flash-lite (Fastest, ultra-low latency)
# - gemini-flash-latest (High throughput)
GEMINI_MODEL=gemma-4-26b-a4b-it

# 3. Session Security Secret (RECOMMENDED for Production)
# A strong random secret key (minimum 32 characters) used to cryptographically HMAC-sign session cookies
# and verify client device fingerprints against session hijacking.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=your_random_32_character_secret_here
